#!/usr/bin/env sh
set -eu
GRADLE_VERSION="9.1.0"
GRADLE_DIR="${HOME}/.gradle/caches/caa-gradle/${GRADLE_VERSION}"
GRADLE_BIN="${GRADLE_DIR}/gradle-${GRADLE_VERSION}/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$GRADLE_DIR"
  ARCHIVE="$GRADLE_DIR/gradle.zip"
  if [ ! -f "$ARCHIVE" ]; then
    echo "Téléchargement de Gradle ${GRADLE_VERSION}..."
    curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "$ARCHIVE"
  fi
  unzip -q -o "$ARCHIVE" -d "$GRADLE_DIR"
  rm -f "$ARCHIVE"
fi
exec "$GRADLE_BIN" "$@"
